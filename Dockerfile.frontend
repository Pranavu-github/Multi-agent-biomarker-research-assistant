FROM python:3.11-slim

WORKDIR /app

# Install only what the frontend needs — no torch/transformers/faiss here
RUN pip install --no-cache-dir \
    streamlit \
    requests \
    pandas \
    numpy \
    python-dotenv \
    loguru

# Copy application code
COPY . .

# Disable Streamlit's browser auto-open and telemetry (needed for server mode)
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
