# ── Copy this file to .env and fill in your API keys ──────────────────────────
# cp .env.example .env

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER_REPLACE_ME

# Groq API key (optional — used as LLM fallback)
GROQ_API_KEY=gsk_PLACEHOLDER_REPLACE_ME

# NCBI Entrez email (required for PubMed / PMC access)
ENTREZ_EMAIL=your.email@example.com

# Semantic Scholar API key (optional — higher rate limits when provided)
SEMANTIC_SCHOLAR_API_KEY=PLACEHOLDER_REPLACE_ME

# Unpaywall email (required for Unpaywall full-text lookup)
UNPAYWALL_EMAIL=your.email@example.com
